# Endless Infinity — SPA routing for Apache / cPanel
# Serves index.html for client-side React Router paths

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep real files and directories (assets, uploads, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite API or uploads if proxied on same host
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/

  # Send all other routes to the React app
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: disable directory listing
Options -Indexes
